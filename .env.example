# =============================================================================
# ETHEX 2026: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Official Scholarship Examination and Student Management Platform for EURO Campus
# =============================================================================

# --- Supabase Database & Auth ---
# Obtain from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Razorpay Payment Gateway ---
# Development: Use test keys (rzp_test_...)
# Production: Use verified company merchant keys (rzp_live_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- Platform Application Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Official EURO Campus Website ---
# Configurable URL for the official institution website link in the footer & navigation.
# If left empty, the portal uses the dynamic admin site_settings database configuration.
EURO_OFFICIAL_WEBSITE_URL=https://eurocampus.in/
NEXT_PUBLIC_EURO_OFFICIAL_WEBSITE_URL=https://eurocampus.in/

# --- Institution & Examination Branding Defaults ---
NEXT_PUBLIC_EXAM_NAME="ETHEX 2026"
NEXT_PUBLIC_INSTITUTION_NAME="EURO Campus"
NEXT_PUBLIC_ACADEMIC_YEAR="2027–2028"
NEXT_PUBLIC_HELPLINE_PCMC="9112223354 / 9112233995"
NEXT_PUBLIC_HELPLINE_SHIKRAPUR="9607035688"
NEXT_PUBLIC_OFFICIAL_EMAIL="admissions@eurocampus.edu.in"

# --- Firebase Live Authentication & Web SDK ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=euro-ethex.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=euro-ethex
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=euro-ethex.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=18637869243
NEXT_PUBLIC_FIREBASE_APP_ID=1:18637869243:web:b40b650c7d441f3566d99e
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-3DDCX5BZSP
